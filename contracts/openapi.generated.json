                          },
                          "categoria": {
                            "type": ["null", "string"]
                          },
                          "precio": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "limite": {
                          "type": "integer"
                        },
                        "desplazamiento": {
                          "type": "integer"
                        },
                        "cantidad": {
