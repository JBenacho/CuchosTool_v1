{
  "name": "cuchostool",
  "private": true,
  "version": "0.1.0",
  "description": "CuchosTool.com - monorepo (E-Commerce + ERP + Core) sobre Node/TS/Fastify/Drizzle + PostgreSQL. Trazabilidad Backlog v6.",
  "workspaces": [
    "apps/*",
    "paquetes/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "dev:api": "npm run dev -w @cuchostool/api",
    "dev:web-ecommerce": "npm run dev -w @cuchostool/web-ecommerce",
    "dev:web-erp": "npm run dev -w @cuchostool/web-erp",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:contracts": "node scripts/validate-contracts.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0"
  }
}
