          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "slug": {
                            "type": "string"
                          },
                          "nombre": {
                            "type": "string"
                          },
                          "descripcion": {
                            "type": ["null", "string"]
                          },
                          "precioCentavos": {
