# Entorno local de desarrollo (NO commitear .env)
POSTGRES_USER=cuchos
POSTGRES_PASSWORD=cuchos_dev_pass
POSTGRES_DB=cuchostool_dev
POSTGRES_PORT=5433
DATABASE_URL=postgres://cuchos:cuchos_dev_pass@localhost:5433/cuchostool_dev
API_PORT=3001
WEB_PORT=5173
LOG_LEVEL=info
JWT_SECRET=dev-secret-cambiar-en-produccion

# Pagos (F3): 'simulado' por defecto; 'wompi' activa el proveedor real
PROVEEDOR_PAGOS_ACTIVO=simulado
WOMPI_URL_BASE=https://production.wompi.co
WOMPI_CLAVE_PUBLICA=
WOMPI_CLAVE_PRIVADA=
WOMPI_CLAVE_INTEGRIDAD=
WOMPI_CLAVE_EVENTOS=

# GCP Pub/Sub (F3-GCP): vacio = evidencia local; con proyecto usa Pub/Sub real
GCP_PROYECTO_ID=
PUBSUB_TOPICO_PEDIDOS=pedidos
PUBSUB_TOPICO_GENERAL=general
PUBLICADOR_INTERVALO_MS=15000
