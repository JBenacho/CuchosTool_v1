{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuchostool.com/contracts/events/inventario-actualizado.schema.json",
  "title": "InventarioActualizado",
  "description": "Evento emitido al cambiar stock/reservas (CU-INT-003). Inventory Service es fuente unica de verdad.",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "com.cuchostool.inventario.actualizado"
    },
    "version": {
      "const": "1.0"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "productoId",
        "stockDisponible",
        "stockReservado"
      ],
      "properties": {
        "productoId": {
          "type": "integer"
        },
        "stockDisponible": {
          "type": "integer",
          "minimum": 0
        },
        "stockReservado": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
